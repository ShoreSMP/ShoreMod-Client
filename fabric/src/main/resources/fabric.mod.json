{
  "schemaVersion": 1,
  "id": "shoremod",
  "version": "${version}",
  "name": "ShoreMod",
  "icon": "assets/shoremod/textures/font/badge.png",
  "description": "ShoreSMP HUD, inventory tools, privacy, local clips and giveaways.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.shoresmp.fabric.ShoreClient"
    ]
  },
  "mixins": [
    "shoremod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=0.141.6"
  },
  "custom": {
    "shoremod:build-target": "1.21.11"
  }
}